# Copy to .env.local and fill in your own values. Never commit .env.local.

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Postgres connection string (Neon: Dashboard -> Connection details)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Base URL the browser uses to reach the API
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk user id that `bun run db:seed` creates demo data for (only this user's rows are touched)
SEED_USER_ID=user_xxx
